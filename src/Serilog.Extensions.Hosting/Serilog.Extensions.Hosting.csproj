<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Serilog support for .NET Core logging in hosted services</Description>
    <Authors>Microsoft;Serilog Contributors</Authors>
    <!-- These must match the Dependencies tab in https://www.nuget.org/packages/microsoft.extensions.hosting at
         the target version. -->
    <TargetFrameworks>net462;netstandard2.0;netstandard2.1;net10.0;net11.0</TargetFrameworks>
    <PackageTags>serilog;aspnet;aspnetcore;hosting</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/serilog/serilog-extensions-hosting</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RootNamespace>Serilog</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.1' ">
    <DefineConstants>$(DefineConstants);FEATURE_MBPW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <DefineConstants>$(DefineConstants);FEATURE_MBPW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
    <DefineConstants>$(DefineConstants);FEATURE_MBPW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" Visible="false" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="PolySharp" Version="1.14.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- The versions of all references in these groups must match the major and minor components of the package version prefix. -->
  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <!-- Note: The Microsoft.Extensions.*.Abstractions libraries are built in from .NET 11 -->
  <!-- So, only reference them on other versions -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>
  
</Project>
